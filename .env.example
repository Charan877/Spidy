# ==============================================================================
# SPIDY — Configuration Environment Variables
# Copy this file to .env and configure your API keys:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Provider: NVIDIA NIM (Recommended)
# Sign up at https://build.nvidia.com to obtain an API key.
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Specialized Model Routing per Engineering Role
NVIDIA_PLANNER_MODEL=z-ai/glm-5.3
NVIDIA_ARCHITECT_MODEL=z-ai/glm-5.3
NVIDIA_CODER_MODEL=z-ai/glm-5.3
NVIDIA_DEBUGGER_MODEL=z-ai/glm-5.3
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=google/gemma-4-31b-it
NVIDIA_GENERAL_MODEL=google/gemma-4-31b-it
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ------------------------------------------------------------------------------
# 2. Fallback AI Provider: OpenRouter
# Automatically activated if primary provider encounters rate limits or errors.
# Sign up at https://openrouter.ai to obtain an API key.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 3. Model Router & Execution Settings
# ------------------------------------------------------------------------------
PRIMARY_PROVIDER=nvidia
FALLBACK_PROVIDER=openrouter
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. Optional Storage & Server Customization
# ------------------------------------------------------------------------------
# SPIDY_DB_PATH=data/spidy.db
# PORT=8501